# 1. cp .env.example .env.local
# 2. Supabase Dashboard → Project Settings → API
# 3. npm run setup:step1

# โดเมนแอป (production) — ใช้บน Vercel และ local ถ้าต้องการทดสอบลิงก์เต็ม
VITE_APP_URL=https://app.npcreate.co.th

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ลิงก์ช่องทางติดต่อลูกค้า (ฟอร์ม /contact + CRM) — fallback เมื่อยังไม่เปิด OAuth
# VITE_NPCREATE_LINE_OA_URL=https://line.me/R/ti/p/@npcreate
# VITE_NPCREATE_FACEBOOK_URL=https://m.me/npcreate

# แชท OA บน chat.line.biz (ทีมงาน desktop)
# VITE_LINE_CHAT_BIZ_ACCOUNT_ID — คัดลอกเฉพาะ segment แรกหลัง chat.line.biz/ (ไม่ใช่ user id ของลูกค้า)
#   ตัวอย่าง URL ในเบราว์เซอร์เมื่อเปิดแชทลูกค้าที่ทัก OA แล้ว:
#   https://chat.line.biz/U2626213ac7c9081487572e27c76826db/chat/U1bfd708d6595baea50b50568a7b84b5f
#                              ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^  ← ใส่ค่านี้
#   ทางเลือก (manager): https://manager.line.biz/account/{เดียวกัน}/chat
# VITE_LINE_CHAT_BIZ_ACCOUNT_ID=U2626213ac7c9081487572e27c76826db
#
# line_user_id ใน CRM = LINE Login OAuth (เช่น Ubc5af7b8ae96bd380b866fce5b4cd970)
# line_oa_chat_user_id = segment หลัง /chat/ ใน URL แชท OA (เช่น U1bfd708d6595baea50b50568a7b84b5f)
# สองค่านี้มักไม่ตรงกันจนกว่าจะผูกช่อง Login กับ OA ใน LINE Developers หรือทีมบันทึก id จากแชท OA ใน CRM
# ลิงก์ .../chat/{userId} บน chat.line.biz ต้องใช้ line_oa_chat_user_id — ใช้ Login id จะ 404
# ค่าเริ่มต้นแอปเปิดรายการแชท OA + คัดลอก user id ให้ค้นหา — ตั้งด้านล่างเป็น true เฉพาะเมื่อทดสอบ direct แล้วใช้ได้
# VITE_LINE_STAFF_DIRECT_USER_CHAT=true

# LINE Login (ฟอร์ม /contact)
# - VITE_LINE_CHANNEL_ID ฝังตอน build (Vite) — ต้องตั้งบน Vercel แล้ว redeploy ถึงจะเห็นปุ่ม "เชื่อมต่อ LINE" บน production
# - แก้ .env.local แล้วต้องรีสตาร์ท npm run dev
# - LINE_CHANNEL_SECRET ใส่เฉพาะ Supabase Edge Function secrets (ไม่ใส่ในแอป)
# - Callback URL ใน LINE Developers Console (ต้องตรงทุกตัวอักษรกับ redirect_uri):
#     https://app.npcreate.co.th/contact   ← ใช้บน production (VITE_APP_URL)
#     http://localhost:5173/contact
#     https://<project>.supabase.co/functions/v1/line-oauth-callback (legacy)
# - เปิด /contact จาก ops.npcreate.co.th ยังใช้ callback ที่ app.npcreate.co.th/contact
# - ข้อความ "โปรดตรวจสอบความถูกต้องของลิงก์" = client_id ผิด หรือ callback URL ไม่ได้ลงทะเบียน
VITE_LINE_CHANNEL_ID=
VITE_LINE_OA_ID=@npcreate

# Facebook Login + Customer Chat (ฟอร์ม /contact)
# VITE_FACEBOOK_APP_ID=
# VITE_FACEBOOK_PAGE_ID=

# Supabase Edge Function line-oauth-callback (Dashboard → Edge Functions → Secrets)
# LINE_CHANNEL_ID=          (เดียวกับ VITE_LINE_CHANNEL_ID)
# LINE_CHANNEL_SECRET=      (จาก LINE Developers Console)
# CONTACT_OAUTH_RETURN_ORIGIN=https://app.npcreate.co.th  (fallback redirect)

# LINE Messaging API — push ข้อความถึงลูกค้า (ใบเสนอราคา / รหัสพอร์ทัล) ผ่าน Edge Function send-line-push
# และฟอร์ม /contact ผ่าน contact-line-handoff (ส่งเข้าแชทหลังกดส่งข้อมูล)
# ใส่เฉพาะ Supabase secrets — ไม่ใส่ใน Vite / แอป
# LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=   (Channel access token ของ LINE Official @npcreate)
# Deploy: npx supabase functions deploy contact-line-handoff

# สำหรับ npm run functions:deploy (ไม่ใส่ในแอป — ใช้เฉพาะเครื่อง IT)
# SUPABASE_ACCESS_TOKEN=
